{
  "functions": [
    {
      "source": "firebase/kangsain-functions/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/kangsain-functions/firestore.rules",
    "indexes": "firebase/kangsain-functions/firestore.indexes.json"
  },
  "hosting": {
    "site": "archive-pilates",
    "public": ".",
    "headers": [
      {
        "source": "/kangsain/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/kangsain/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/kangsain/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/dashboard/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      ".git",
      ".git/**",
      "firebase/**",
      "firebase.json",
      "package.json",
      "package-lock.json",
      "dashboard/src/**",
      "**/node_modules/**",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
