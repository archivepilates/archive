        "AGENTS.md",
        "docs/**",
        "artifacts/**",
        "output/**",
        "archivein/private-reports/sample-*/**",
        "scripts/**"
      ],
      "redirects": [
        {
          "source": "/kangsain",
          "destination": "/archivein/",
          "type": 301
        },
        {
          "source": "/kangsain/",
          "destination": "/archivein/",
          "type": 301
        },
        {
          "source": "/kangsain/**",
          "destination": "/archivein/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/archivein/api/groupSurveySubmit",
          "function": {
            "functionId": "ingestPrivateSurveyResponse",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/archivein/api/privateChart",
          "function": {
            "functionId": "privateLessonChartApi",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/archivein/api/privateLessonReport",
          "function": {
            "functionId": "privateLessonReportView",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/archivein/api/memberSignupContract",
          "function": {
            "functionId": "memberSignupContract",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/archivein/api/onsiteWelcomeRequest",
