{
  "hosting": {
    "site": "archive-pilates-home",
    "predeploy": [
      "npm run validate:archive-home-team",
      "npm run validate:archive-home-classroom",
      "npm run validate:video-sales-growth"
    ],
    "postdeploy": [
      "npm run verify:archive-home-classroom-live"
    ],
    "public": "official-home",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/assets/imweb-my-classroom-20260723a.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/teams",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/teams/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/video-guide{,/**}",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/site.webmanifest",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
        ]
      },
      {
        "source": "/favicon.ico",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/*.png",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/teams/ayoung",
        "destination": "/teams",
        "type": 301
      },
      {
        "source": "/shop",
        "destination": "https://archivepilates.imweb.me/16",
        "type": 302
      },
      {
        "source": "/videos",
        "destination": "https://archivepilates.imweb.me/17",
        "type": 302
      },
      {
        "source": "/online",
        "destination": "https://archivepilates.imweb.me/17",
        "type": 302
      },
      {
        "source": "/offline",
        "destination": "https://archivepilates.imweb.me/18",
        "type": 302
      },
      {
        "source": "/careers",
        "destination": "https://apply.archivepilates.com/",
        "type": 302
      },
      {
        "source": "/my-classroom",
        "destination": "https://archivepilates.imweb.me/48",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/video-guide",
        "destination": "/video-guide/index.html"
      },
      {
        "source": "/teams",
        "destination": "/teams/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
