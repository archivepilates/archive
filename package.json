{
  "private": true,
  "scripts": {
    "build:dashboard": "esbuild dashboard/src/vendor.js --bundle --format=iife --target=es2020 --outfile=dashboard/assets/vendor.js --minify",
    "download:studiomate-sales": "node scripts/download-studiomate-sales-excels.mjs",
    "run:archive-dashboard-sales-daily": "node scripts/run-archive-dashboard-sales-daily.mjs",
    "sync:archive-dashboard-db": "node scripts/sync-archive-dashboard-db.mjs",
    "rebuild:member-360": "node scripts/rebuild-member-360-db.mjs",
    "prepare:archive-core-transition": "node scripts/prepare-archive-core-transition-data.mjs",
    "verify:archivein-admin": "node scripts/verify-archivein-admin-firestore-access.mjs",
    "build:contracts": "node firebase/kangsain-functions/functions/node_modules/typescript/bin/tsc -p firebase/packages/contracts/tsconfig.json",
    "prepare:function-codebases": "node scripts/prepare-functions-codebase.mjs all",
    "build:function-codebases": "npm run build:contracts && npm run prepare:function-codebases && node firebase/kangsain-functions/functions/node_modules/typescript/bin/tsc -p firebase/function-codebases/alimtalk/tsconfig.json && node firebase/kangsain-functions/functions/node_modules/typescript/bin/tsc -p firebase/function-codebases/private-chart/tsconfig.json && node firebase/kangsain-functions/functions/node_modules/typescript/bin/tsc -p firebase/function-codebases/sync/tsconfig.json && node firebase/kangsain-functions/functions/node_modules/typescript/bin/tsc -p firebase/function-codebases/app/tsconfig.json",
    "validate:onsite-welcome": "node scripts/validate-onsite-welcome-release.mjs",
    "detect:affected-functions": "node scripts/detect-affected-function-codebases.mjs",
    "deploy:affected-functions:dry": "node scripts/deploy-affected-functions.mjs --dry-run",
    "deploy:affected-functions": "node scripts/deploy-affected-functions.mjs --apply",
    "validate:function-boundaries": "node scripts/validate-functions-boundaries.mjs",
    "validate:data-source-policy": "node scripts/validate-data-source-policy.mjs",
    "deploy:archivein-live": "bash scripts/deploy-archivein-live.sh",
    "process:admin-emergency-sync": "node scripts/process-admin-emergency-sync-requests.mjs",
    "validate:archive-core-hosting": "node scripts/validate-archive-core-hosting-deploy.mjs",
    "deploy:archive-core-live": "bash scripts/deploy-archive-core-live.sh",
    "recompute:private-session-ledger": "node scripts/recompute-private-session-ledger.mjs",
    "release:promote-main:dry": "node scripts/promote-release-to-main.mjs",
    "release:promote-main": "node scripts/promote-release-to-main.mjs --apply",
    "studiomate:member-excel": "node firebase/kangsain-functions/macmini-studiomate/download-member-excel.mjs",
    "studiomate:reservation-deadline": "node firebase/kangsain-functions/macmini-studiomate/set-reservation-deadline.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.9",
    "firebase": "^10.14.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.59.1"
  }
}
