{
  "phase": "physical-codebase-ready",
  "project": "archive-pilates",
  "previousFirebaseCodebase": "default",
  "physicalCodebaseSplitEnabled": true,
  "generationRule": "Each physical codebase source is generated from firebase/kangsain-functions/functions/src during predeploy so repo/worktree path changes do not break imports.",
  "targetCodebases": {
    "functions-alimtalk": {
      "physicalSource": "firebase/function-codebases/alimtalk",
      "sourceEntrypoint": "firebase/kangsain-functions/functions/src/exports/alimtalk.ts",
      "owns": [
        "scheduledProcessAlimtalkQueue",
        "scheduledQueueAndSendAlimtalkDaily",
        "scheduledQueueAndSendReservationOpenAlimtalk",
        "scheduledSyncAlimtalkTemplateStatuses",
        "approveAlimtalkBatch",
        "operatorSendPricingInquiryAlimtalk",
        "operatorSendRecommendedMealProgramAlimtalk"
      ],
      "forbidden": ["StudioMate writes", "Google Contacts writes", "private chart generation"]
    },
    "functions-private-chart": {
      "physicalSource": "firebase/function-codebases/private-chart",
      "sourceEntrypoint": "firebase/kangsain-functions/functions/src/exports/privateChart.ts",
      "owns": [
        "scheduledSyncPrivateSurveyResponses",
        "scheduledProcessStaffSurveyAlimtalks",
        "scheduledSyncPrivateSurveyNotion",
        "scheduledCreatePrivateLessonChartRequests",
        "scheduledReconcileCurrentMonthPrivateLessonCharts",
        "scheduledGeneratePrivateLessonChartReports",
        "scheduledPurgeDiscardedMemberSignupContracts",
        "ingestPrivateSurveyResponse",
        "privateSurveyResponseView",
        "privateLessonChartApi",
        "privateLessonReportView",
        "memberSignupContract",
        "onsiteWelcomeRequest",
        "methodCueCardReview",
        "notionPrivateLessonReportWebhook",
        "redirectShortLink",
        "processPrivateSurveyIntake",
        "syncPrivateLessonSessionFromRequest",
        "syncPrivateLessonSessionFromRecord"
      ],
      "forbidden": ["daily Alimtalk candidate selection", "StudioMate writes", "Google Contacts writes"]
    },
    "functions-sync": {
      "physicalSource": "firebase/function-codebases/sync",
      "sourceEntrypoint": "firebase/kangsain-functions/functions/src/exports/sync.ts",
      "owns": [
        "scheduledSyncLecturesDaily",
        "scheduledPollManagerNotices",
        "scheduledProcessWriteQueue",
        "scheduledProcessContactSyncJobs",
        "scheduledAttendanceReminder",
        "scheduledCreateParkingDiscountJobs",
        "scheduledSyncDashboardDaily",
        "scheduledPreSecurityRawMirror",
        "syncDashboardNow",
        "adminSyncLecturesRange",
        "adminSyncManagerStaffs",
        "adminPollManagerNotices",
        "processAdminSyncRequest"
      ],
      "forbidden": ["SOLAPI sends", "private chart report generation"]
    },
    "functions-app": {
      "physicalSource": "firebase/function-codebases/app",
      "sourceEntrypoint": "firebase/kangsain-functions/functions/src/exports/app.ts",
      "owns": [
        "getInstructorHome",
        "loginStaffWithPin",
        "setupStaffPinWithTempCode",
        "submitBookingAttendance",
        "submitMemberMemo",
        "getMemberMemoHistory",
        "searchMembers",
        "lookupKioskCheckin",
        "submitKioskCheckin",
        "getKioskParkingJobStatus",
        "registerParkingVehicle",
        "getParkingDashboard",
        "removeParkingVehicle",
        "runParkingAutoApplyNow",
        "registerFcmToken",
        "getInstructorEvaluationQuiz",
        "submitInstructorEvaluationQuiz",
        "adjustInstructorEvaluationEssayScore",
        "instructorApplicantEvaluationApi",
        "recommendedMealSurveyApi",
        "adminIssueStaffTempCode",
        "processParkingDiscountJob"
      ],
      "forbidden": ["scheduled jobs", "external member-facing sends"]
    }
  },
  "migrationRule": "Deploy physical codebases one at a time after prepare/build/validate and dry-run. Do not restore the default all-in-one source unless a rollback is intentional."
}
