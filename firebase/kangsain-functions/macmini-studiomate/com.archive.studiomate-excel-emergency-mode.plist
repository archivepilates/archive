<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.archive.studiomate-excel-emergency-mode</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/archivepilates/dev/archive-in-runtime/scripts/run-studiomate-excel-emergency-mode.mjs</string>
    <string>--download</string>
    <string>--apply</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/archivepilates/dev/archive-in-runtime</string>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TZ</key>
    <string>Asia/Seoul</string>
    <key>HEADLESS</key>
    <string>true</string>
    <key>STUDIOMATE_BASE_URL</key>
    <string>https://arcpilates.studiomate.kr</string>
    <key>GOOGLE_APPLICATION_CREDENTIALS</key>
    <string>/Users/archivepilates/ArchiveIN/secrets/google/archive-codex-operator.json</string>
    <key>GOOGLE_CLOUD_PROJECT</key>
    <string>archive-pilates</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/archivepilates/ArchiveIN/emergency/logs/studiomate-excel-emergency-mode.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/archivepilates/ArchiveIN/emergency/logs/studiomate-excel-emergency-mode.err.log</string>
</dict>
</plist>
