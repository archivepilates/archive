{
  "name": "archive-kangsain-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"../*.json\" \"../*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"../*.json\" \"../*.md\"",
    "firebase": "firebase --config ../firebase.json --project archive-pilates",
    "serve": "npm run build && npm run firebase -- emulators:start --only functions,firestore",
    "deploy": "npm run build && npm run firebase -- deploy --only functions,firestore:rules,firestore:indexes",
    "deploy:functions": "npm run build && npm run firebase -- deploy --only functions",
    "deploy:firestore": "npm run firebase -- deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "eslint": "^10.3.0",
    "firebase-tools": "^15.16.0",
    "npm": "^11.13.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
