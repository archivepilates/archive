rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isManager() {
      return signedIn() &&
        (
          request.auth.token.role in ['owner', 'manager'] ||
          request.auth.token.email in [
            'p01086488585@archivepilates.com',
            'p01029244425@archivepilates.com'
          ]
        );
    }

    function isInstructor(staffId) {
      return signedIn() &&
        (
          request.auth.token.staffId == staffId ||
          (
            exists(/databases/$(database)/documents/staffs/$(staffId)) &&
            (
              get(/databases/$(database)/documents/staffs/$(staffId)).data.uid == request.auth.uid ||
              get(/databases/$(database)/documents/staffs/$(staffId)).data.email == request.auth.token.email
            )
          )
        );
    }

    function sameStudio(studioId) {
      return signedIn() &&
        (
          request.auth.token.studioId == studioId ||
          isManager()
        );
    }

    function isIncludedStaff(data) {
      return signedIn() &&
        data.staffIds is list &&
        request.auth.token.staffId in data.staffIds;
    }

    function bookingCanUpdateAttendance(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return booking.appStatus == 'reserved' &&
        booking.lectureStartAt is timestamp &&
        booking.lectureStartAt <= request.time;
    }

    match /studios/{studioId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /staffs/{staffId} {
      allow read: if isManager() || isInstructor(staffId);
      allow write: if false;
    }

    match /lectures/{lectureId} {
      allow read: if isManager() || isInstructor(resource.data.staffId);
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isManager() || isInstructor(resource.data.staffId);
      allow update: if
        (isManager() || isInstructor(resource.data.staffId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'attendanceStatus',
          'syncStatus',
          'lastChangedBy',
          'lastMemoPreview',
          'lastMemoAt',
          'updatedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['attendanceStatus']) ||
          (resource.data.appStatus == 'reserved' &&
            resource.data.lectureStartAt is timestamp &&
            resource.data.lectureStartAt <= request.time &&
            request.resource.data.attendanceStatus in ['unchecked', 'attended', 'absent', 'late_cancel'])) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['syncStatus']) ||
          request.resource.data.syncStatus == 'pending') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastChangedBy']) ||
          request.resource.data.lastChangedBy == request.auth.uid);
      allow create, delete: if false;
    }

    match /instructorViews/{viewId} {
      allow read: if isManager() || isInstructor(resource.data.staffId);
      allow write: if false;
    }

    match /consultations/{consultationId} {
      allow read: if isManager() || sameStudio(resource.data.studioId) || isInstructor(resource.data.staffId) || isIncludedStaff(resource.data);
      allow write: if false;
    }

    match /otherSchedules/{scheduleId} {
      allow read: if isManager() || sameStudio(resource.data.studioId) || isInstructor(resource.data.staffId) || isIncludedStaff(resource.data);
      allow write: if false;
    }

    match /attendanceSummaries/{summaryId} {
      allow read, write: if false;
    }

    match /adminActions/{actionId} {
      allow read: if isManager();
      allow update: if isManager() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedActionKeys',
          'completedByUid',
          'completedAt'
        ]) &&
        request.resource.data.completedActionKeys is list &&
        request.resource.data.completedByUid == request.auth.uid &&
        request.resource.data.completedAt is timestamp;
      allow write: if false;
    }

    match /memberTags/{memberId} {
      allow read, write: if false;
    }

    match /memberProfiles/{memberId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow write: if false;
    }

    match /memberContactIndex/{memberId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow write: if false;
    }

    match /contactSyncJobs/{jobId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow write: if false;
    }

    match /alimtalkCandidates/{candidateId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow update: if isManager() &&
        sameStudio(resource.data.studioId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedByUid',
          'reviewedAt',
          'updatedAt'
        ]) &&
        request.resource.data.status in ['reviewed', 'queued', 'skipped'] &&
        request.resource.data.reviewedByUid == request.auth.uid;
      allow create, delete: if false;
    }

    match /alimtalkSends/{sendId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow write: if false;
    }

    match /privateSurveyIntakes/{intakeId} {
      allow read: if false;
      allow create: if
        request.resource.data.docKey == intakeId &&
        request.resource.data.responseId is string &&
        request.resource.data.responseId.matches('^psr-[a-z0-9-]{8,80}$') &&
        request.resource.data.accessToken is string &&
        request.resource.data.accessToken.matches('^[a-f0-9]{16,80}$') &&
        request.resource.data.memberName is string &&
        request.resource.data.memberName.size() > 0 &&
        request.resource.data.memberName.size() <= 40 &&
        request.resource.data.memberPhone is string &&
        request.resource.data.memberPhone.matches('^[0-9]{10,11}$') &&
        request.resource.data.answers is map &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /privateSurveyPublic/{docKey} {
      allow read: if docKey.matches('^(psr|gsr)-[a-z0-9-]{8,80}-[a-f0-9]{16,80}$');
      allow write: if false;
    }

    match /privateSurveyResponses/{responseId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow write: if false;
    }

    match /inbodyWebhookEvents/{eventId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow write: if false;
    }

    match /memberMemos/{memoId} {
      allow read: if
        signedIn() &&
        sameStudio(resource.data.studioId) &&
        (isManager() ||
          resource.data.visibility == 'staff_and_manager' ||
          resource.data.createdByUid == request.auth.uid);
      allow update, delete: if false;
      allow create: if
        signedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.memoId == memoId &&
        request.resource.data.syncStatus == 'pending' &&
        request.resource.data.visibility in ['staff_and_manager', 'manager_only', 'creator_only'] &&
        request.resource.data.memoType in ['member_note', 'lesson_note', 'private_instructor_note'] &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000 &&
        sameStudio(request.resource.data.studioId) &&
        (isManager() ||
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.staffId == request.auth.token.staffId);
    }

    match /conversations/{conversationId} {
      allow read: if signedIn();
      allow create: if
        signedIn() &&
        request.resource.data.conversationId == conversationId &&
        request.resource.data.studioId is string &&
        request.resource.data.threadStaffId is string &&
        request.resource.data.threadStaffName is string &&
        request.resource.data.lastSenderStaffId is string &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 120;
      allow update: if
        (
          signedIn() &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.studioId is string &&
          request.resource.data.threadStaffId is string &&
          request.resource.data.threadStaffName is string &&
          request.resource.data.lastSenderStaffId is string &&
          request.resource.data.lastMessage is string &&
          request.resource.data.lastMessage.size() <= 120
        ) ||
        (
          signedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'managerReadAt',
            'staffReadAt'
          ])
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if
          signedIn() &&
          request.resource.data.messageId == messageId &&
          request.resource.data.conversationId == conversationId &&
          request.resource.data.studioId is string &&
          request.resource.data.threadStaffId is string &&
          request.resource.data.senderStaffId is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 1000 &&
          request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /notices/{noticeId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /studiomateRaw/{path=**} {
      allow read, write: if false;
    }

    match /syncStates/{syncName} {
      allow read: if isManager();
      allow write: if false;
    }

    match /opsState/{stateId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /adminSyncRequests/{requestId} {
      allow read: if isManager();
      allow create: if
        isManager() &&
        request.resource.data.requestId == requestId &&
        request.resource.data.studioId is string &&
        sameStudio(request.resource.data.studioId) &&
        request.resource.data.startDate is string &&
        request.resource.data.endDate is string &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /workLanes/{laneId} {
      allow read: if isManager();
      allow write: if false;

      match /{document=**} {
        allow read: if isManager();
        allow write: if false;
      }
    }

    match /automationStatus/{statusId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /sourceImports/{importId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /dataQualityIssues/{issueId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /dashboardSnapshots/{snapshotId} {
      allow read: if signedIn() && snapshotId == 'current';
      allow write: if false;
    }

    match /dashboardMonthlyMetrics/{metricId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /dashboardInstructorMetrics/{metricId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /dashboardTicketMetrics/{metricId} {
      allow read: if isManager();
      allow write: if false;
    }

    match /studiomateMemoWriteJobs/{jobId} {
      allow read: if isManager() && sameStudio(resource.data.studioId);
      allow write: if false;
    }

    match /alimtalkTemplateStates/{templateCode} {
      allow read: if isManager();
      allow write: if false;
    }

    match /writeQueue/{jobId} {
      allow read: if isManager();
      allow create: if
        signedIn() &&
        sameStudio(request.resource.data.studioId) &&
        request.resource.data.jobId == jobId &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.attempts == 0 &&
        request.resource.data.maxAttempts == 5 &&
        request.resource.data.lastError == null &&
        request.resource.data.type in ['bookingAttendanceUpdate', 'memberMemoCreate'] &&
        request.resource.data.payload is map &&
        (request.resource.data.type != 'bookingAttendanceUpdate' ||
          (request.resource.data.payload.bookingId is string &&
            bookingCanUpdateAttendance(request.resource.data.payload.bookingId)));
      allow update, delete: if false;
    }

    match /tokenCache/{tokenKey} {
      allow read, write: if false;
    }

    match /fcmTokens/{tokenId} {
      allow read: if signedIn() && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    match /apiLogs/{logId} {
      allow read: if isManager();
      allow write: if false;
    }
  }
}
