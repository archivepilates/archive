{
  "firestore": [{"database": "reservation-mirror", "rules": "firestore.rules", "indexes": "firestore.indexes.json"}],
  "hosting": {
    "site": "archive-pilates-booking-test",
    "public": "dist",
    "ignore": ["**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/api/**", "run": {"serviceId": "archive-reservation-mirror", "region": "asia-northeast3", "pinTag": true}}
    ],
    "headers": [{"source": "**", "headers": [{"key": "Cache-Control", "value": "no-store"}, {"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "Referrer-Policy", "value": "no-referrer"}]}]
  }
}
